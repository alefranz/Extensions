<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WantsACracker.Extensions.Http.Resilience.Sample</RootNamespace>
    <Description>A minimal runnable sample: a named HttpClient wired with AddStandardResilienceHandler, exercised against an in-process HTTP endpoint.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the source project directly, following the fork's test/bench
         convention: the migration packages are not packed or committed, so the
         local nupkg feed (eng/local-packages) only carries the core WantsACracker
         package and cannot stand in for WantsACracker.Extensions.Http.Resilience. -->
    <ProjectReference Include="..\..\..\src\Libraries\Microsoft.Extensions.Http.Resilience\WantsACracker.Extensions.Http.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
