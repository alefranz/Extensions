<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WantsACracker.Extensions.Resilience.Test</RootNamespace>
    <Description>Unit tests for Microsoft.Extensions.Resilience</Description>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The WantsACracker core package is intentionally unsigned; these delay-signed (public-key)
         test assemblies referencing it are fine on .NET, so the strong-name mismatch (CS8002) is
         suppressed. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The WantsACracker core package is intentionally unsigned, and the project under test
         references it by its unsigned identity. StrongNamer re-signs unsigned references with
         its own key, which would change that identity and break compilation, so it is disabled
         here. Tests only target .NET (8+), where the runtime does not enforce strong-name
         verification of referenced assemblies. -->
    <DisableStrongNamer>true</DisableStrongNamer>
  </PropertyGroup>

  <PropertyGroup>
    <InjectSharedNumericExtensions>true</InjectSharedNumericExtensions>
  </PropertyGroup>

  <ItemGroup>
    <None Update="configs\appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="configs\optionsOnChangeTestOriginal.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="configs\optionsOnChangeTestNew.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Libraries\Microsoft.Extensions.Resilience\WantsACracker.Extensions.Resilience.csproj" ProjectUnderTest="true" />
    <ProjectReference Include="..\..\..\src\Libraries\Microsoft.Extensions.Diagnostics.Testing\Microsoft.Extensions.Diagnostics.Testing.csproj" />
    <ProjectReference Include="..\..\..\src\Libraries\Microsoft.Extensions.Diagnostics.ExceptionSummarization\Microsoft.Extensions.Diagnostics.ExceptionSummarization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ValueTuple" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net6.0'))" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
