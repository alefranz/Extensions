<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>WantsACracker.Extensions.Http.Resilience</RootNamespace>
    <!-- No published WantsACracker.Extensions.Http.Resilience baseline exists to validate against yet. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <!-- The WantsACracker core package is an intentionally unsigned independent
         package; these delay-signed (public-key) assemblies referencing it are
         fine on .NET, so the strong-name mismatch (CS8002) is suppressed.
         SYSLIB1202: the Http*StrategyOptions types are empty subclasses of the
         WantsACracker strategy-options types, which validate their values in the
         Add* builder methods rather than via data annotations, so the
         data-validation source generator finds no validatable members on the
         subclass; the warning is suppressed. -->
    <NoWarn>$(NoWarn);CS8002;SYSLIB1202</NoWarn>
    <TargetFrameworks>$(NetCoreTargetFrameworks);netstandard2.0;net462</TargetFrameworks>
    <!-- The published sibling package ships net462/netstandard2.0 assets; this only silences the
         repo-standard "not tested with net462" compat warning (same as Microsoft.Extensions.Caching.Hybrid). -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <Description>HTTP resilience integration for IHttpClientFactory, with a source-compatible migration path for supported Microsoft.Extensions.Http.Resilience scenarios.</Description>
    <Workstream>Resilience</Workstream>
  </PropertyGroup>

  <!-- WantsACracker package metadata (wants-a-cracker divergence; see UPSTREAM.md).
       PackageLicenseExpression=MIT is inherited from eng/MSBuild/Packaging.props. -->
  <PropertyGroup>
    <Authors>WantsACracker contributors</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/alefranz/Extensions</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alefranz/WantsACracker-Development</PackageProjectUrl>
    <!-- Arcade's ProjectDefaults.targets (imported after the project body) unconditionally
         sets Copyright=$(CopyrightMicrosoft), so override that value here: the package
         must not carry the default "© Microsoft Corporation" identity. Derived-code
         attribution to the .NET Foundation lives in THIRD-PARTY-NOTICES.TXT. -->
    <CopyrightMicrosoft>© WantsACracker contributors</CopyrightMicrosoft>
    <!-- Suppress the Arcade-default .NET icon; WantsACracker packages carry no icon yet. -->
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <UseLoggingGenerator>true</UseLoggingGenerator>
    <UseMetricsGenerator>true</UseMetricsGenerator>
    <InjectSharedNumericExtensions>true</InjectSharedNumericExtensions>
    <InjectSharedThrow>true</InjectSharedThrow>
    <InjectDiagnosticAttributesOnLegacy>true</InjectDiagnosticAttributesOnLegacy>
    <InjectTrimAttributesOnLegacy>true</InjectTrimAttributesOnLegacy>
    <InjectSharedDataValidation>true</InjectSharedDataValidation>
    <InjectSharedPools>true</InjectSharedPools>
    <InjectSharedDiagnosticIds>true</InjectSharedDiagnosticIds>
    <InjectExperimentalAttributeOnLegacy>true</InjectExperimentalAttributeOnLegacy>
  </PropertyGroup>

  <PropertyGroup>
    <Stage>normal</Stage>
    <MinCodeCoverage>97</MinCodeCoverage>
    <MinMutationScore>100</MinMutationScore>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Disable "Published symbols cannot be deleted to maintain compatibility" warning
         because we have different APIs for different TFMs. -->
    <NoWarn Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net462'">$(NoWarn);LA0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.Extensions.Resilience\WantsACracker.Extensions.Resilience.csproj" />
  </ItemGroup>

  <!-- wants-a-cracker divergence (see UPSTREAM.md): the un-renamed sibling
       dependency is consumed from the published 10.9.0 line instead of the
       in-tree local-train project (10.10.0-dev is unpublished, which would
       make the packed package unresolvable from public feeds). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Diagnostics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WantsACracker" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net462'">
    <!-- WantsACracker divergence (see UPSTREAM.md): the standard handler classifies JsonContent
         request bodies as replayable on every TFM; the System.Net.Http.Json reference is only
         needed on the legacy TFMs, mirroring the WantsACracker core package. -->
    <PackageReference Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- wants-a-cracker: pack a package-specific third-party notices file at the package root -->
    <None Include="THIRD-PARTY-NOTICES.TXT" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleToTest Include="$(AssemblyName).Tests" />
    <InternalsVisibleToDynamicProxyGenAssembly2 Include="*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="buildTransitive\$(MinimumSupportedTfmForPackaging)\"
          Condition="'$(MinimumSupportedTfmForPackaging)' != '' and $(TargetFrameworks.Contains('$(MinimumSupportedTfmForPackaging)'))" />

    <!-- For net462 we copy all buildTransitive files except the .targets file. We have to rename the .targets file
         when copying it because our build process automatically adds a .targets file with the same name as the project
         file. Then we'll import the renamed .targets file in the automatically added .targets file. For that we need
         to set the _AdditionalNETStandardCompatErrorFileContents variable. -->
    <None Include="buildTransitive\**\*"
          Exclude="buildTransitive\$(MSBuildProjectName).targets"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="buildTransitive\net462\"
          Condition="'$(IsPackNet462)' == 'true'" />
    
    <None Include="buildTransitive\$(MSBuildProjectName).targets"
          CopyToOutputDirectory="PreserveNewest"
          Pack="true"
          PackagePath="buildTransitive\net462\$(MSBuildProjectName).net462.targets"
          Condition="'$(IsPackNet462)' == 'true'" />
  </ItemGroup>

  <!-- For net462 we automatically add the .targets file, and to include the code that checks the version of the
       Grpc.Net.ClientFactory package we need to set the _AdditionalNETStandardCompatErrorFileContents variable. -->
  <PropertyGroup>
    <_AdditionalNETStandardCompatErrorFileContents>
      <![CDATA[
  <Import Project="%24(MSBuildThisFileDirectory)\$(MSBuildProjectName).net462.targets" />
]]>
    </_AdditionalNETStandardCompatErrorFileContents>
  </PropertyGroup>
</Project>
